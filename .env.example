GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMMA_MODEL=gemma-4-4b-it
SYSHEALTH_URL=http://localhost:5060
SYSHEALTH_DB_PATH=../projeto_fit/nutricao.db
SENTINELA_DB_PATH=../sentinela/data/sentinela_rj.db

# Notificações Cronos: telegram | discord | both
NOTIFY_CHANNEL=telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Bot bidirecional (services/run_telegram.bat)
TELEGRAM_BOT_ENABLED=1
TELEGRAM_POLL_TIMEOUT=30
# TELEGRAM_ALLOWED_CHAT_IDS=123456,789012
TELEGRAM_STREAMING=1
TELEGRAM_STREAM_EDIT_CHARS=350
# TELEGRAM_KNOWLEDGE_PERSIST=1

# Classify LLM
CLASSIFY_LLM_FALLBACK=1
CLASSIFY_LLM_DISAMBIGUATE=0

# Memória e RAG
CROSS_CHAT_MEMORY=1
CROSS_CHAT_MEMORY_LIMIT=5
USER_FACTS=1
KNOWLEDGE_RAG=1
KNOWLEDGE_EMBEDDINGS=1
# GEMINI_EMBED_MODEL=models/text-embedding-004

# Discord (Vigia + Cronos quando NOTIFY_CHANNEL inclui discord)
DISCORD_WEBHOOK_LOGS=https://discord.com/api/webhooks/your_logs_webhook
DISCORD_WEBHOOK_SENTINELA=https://discord.com/api/webhooks/your_sentinela_webhook
DISCORD_WEBHOOK_SAUDE=https://discord.com/api/webhooks/your_saude_webhook
DISCORD_WEBHOOK_BRIEFING=https://discord.com/api/webhooks/your_briefing_webhook
