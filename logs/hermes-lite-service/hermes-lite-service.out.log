import sqlite3
import matplotlib.pyplot as plt

sql = """
SELECT f.razao_social, SUM(c.valor_global) AS total_contratado
FROM contratos c
JOIN fornecedores f ON c.fornecedor_ni = f.ni
GROUP BY f.razao_social
ORDER BY total_contratado DESC
LIMIT 10
"""

conn = sqlite3.connect(SENTINELA_DB)
cursor = conn.cursor()
cursor.execute(sql)
rows = cursor.fetchall()
conn.close()

print("Maiores Fornecedores por Valor Total Contratado:")
print("-" * 60)
for i, (razao_social, total_contratado) in enumerate(rows):
    print(f"{i+1:2}. {razao_social:<40} R$ {total_contratado:,.2f}")
print("-" * 60)

# Prepare data for plotting
fornecedores_nomes = [row[0] for row in rows]
valores = [row[1] for row in rows]

# Plotting
plt.style.use('dark_background')
fig, ax = plt.subplots(figsize=(12, 7))
fig.patch.set_facecolor('#0d1117')
ax.set_facecolor('#0d1117')

# Sort for plotting horizontal bars from smallest to largest
fornecedores_nomes.reverse()
valores.reverse()

ax.barh(fornecedores_nomes, valores, color='#7c3aed')
ax.set_xlabel('Valor Total Contratado (R$)', color='white')
ax.set_ylabel('Fornecedor', color='white')
ax.set_title('Top 10 Maiores Fornecedores por Valor Contratado', color='white')
ax.tick_params(axis='x', colors='white')
ax.tick_params(axis='y', colors='white')
ax.xaxis.label.set_color('white')
ax.yaxis.label.set_color('white')
ax.title.set_color('white')

# Improve layout
plt.tight_layout()
