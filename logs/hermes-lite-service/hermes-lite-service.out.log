import sqlite3
import matplotlib.pyplot as plt

sql = (
    'SELECT f.razao_social, SUM(c.valor_global) AS total_contratos '
    'FROM contratos c '
    'JOIN fornecedores f ON c.fornecedor_ni = f.ni '
    'GROUP BY f.razao_social '
    'ORDER BY total_contratos DESC '
    'LIMIT 5'
)

conn = sqlite3.connect(SENTINELA_DB)
rows = conn.execute(sql).fetchall()
conn.close()

print("Top 5 Fornecedores com Maiores Contratos:")
print("----------------------------------------------------------------")
print(f"{'Ranking':<8} {'Fornecedor':<40} {'Valor Total (R$)':>20}")
print("----------------------------------------------------------------")
for i, (nome, total) in enumerate(rows, 1):
    print(f"{i:<8} {nome:<40} {total:>20,.2f}")
print("----------------------------------------------------------------")

nomes = [r[0][:35] for r in rows]
valores = [r[1] for r in rows]

plt.style.use('dark_background')
fig, ax = plt.subplots(figsize=(12, 6))
fig.patch.set_facecolor('#0d1117')
ax.set_facecolor('#0d1117')

ax.barh(nomes[::-1], valores[::-1], color='#7c3aed')
ax.set_xlabel('Valor Total dos Contratos (R$)', color='white')
ax.set_ylabel('Fornecedor', color='white')
ax.set_title('Top 5 Fornecedores por Valor Total de Contratos', color='white')
ax.tick_params(axis='x', colors='white')
ax.tick_params(axis='y', colors='white')
ax.xaxis.get_major_formatter().set_scientific(False)
ax.xaxis.get_major_formatter().set_useOffset(False)
ax.set_xticks(ax.get_xticks())
ax.set_xticklabels([f'R$ {x:,.0f}' for x in ax.get_xticks()])

plt.tight_layout()
plt.show()
